{
  "name": "cardinal-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Cardinal agent: run GitHub Actions jobs on your own machine, one fresh VM or container per job",
  "type": "module",
  "bin": {
    "cardinal-agent": "./src/main.ts"
  },
  "scripts": {
    "prepare-base": "node src/main.ts prepare",
    "start": "node src/main.ts run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
