{
  "name": "cardinal-dispatcher",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node --env-file-if-exists=.env.local scripts/smoke.ts",
    "create-app": "node scripts/create-app.ts",
    "open": "node --env-file-if-exists=.env.local scripts/open.ts",
    "driver-test": "CARDINAL_DRIVER_TEST=1 node --env-file-if-exists=.env.local node_modules/.bin/vitest run test/driver-contract.test.ts"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@octokit/auth-app": "^8.3.1",
    "@vercel/functions": "^3.10.2",
    "@vercel/sandbox": "^3.8.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
