GITHUB_APP_ID=
# PEM private key. Literal newlines or \n escapes both work.
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
CARDINAL_IMAGE=cardinal-runner:v0.1
CARDINAL_DEFAULT_SIZE=cardinal
# Optional
# CARDINAL_TIMEOUT_MINUTES=60
# CARDINAL_IDLE_TIMEOUT_SECONDS=300
# CARDINAL_REGION=iad1
# Vercel Sandbox auth is automatic via OIDC when deployed on Vercel.
# Local dev: `vercel env pull` (gives VERCEL_OIDC_TOKEN), or set VERCEL_TEAM_ID, VERCEL_PROJECT_ID, VERCEL_TOKEN.
